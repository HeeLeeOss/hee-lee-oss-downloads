{
  "version": "1",
  "agents": [
    {
      "id": "claude-code",
      "kind": "cli",
      "vendor": "anthropic",
      "capabilities": {
        "editsFiles": true,
        "research": true,
        "translation": true,
        "writing": true,
        "headless": true
      },
      "trusted": true,
      "tierModels": {
        "frontier": "opus",
        "standard": "sonnet",
        "light": "haiku"
      },
      "invocation": {
        "command": "claude",
        "authFailurePatterns": ["Please run /login","OAuth token (has )?expired","Invalid API key","Not logged in"],
        "argsTemplate": ["-p", "{permissions}", "--model", "{model}"],
        "promptChannel": "stdin",
        "permissions": {
          "supervised": ["--permission-mode", "acceptEdits"],
          "unattended": ["--dangerously-skip-permissions"]
        },
        "noDelegationArgs": ["--disallowedTools", "Agent", "Task", "Workflow", "RunWorkflow"],
        "turnCapArgs": ["--max-turns", "{maxTurns}"]
      },
      "auth": {
        "keyEnv": "ANTHROPIC_API_KEY",
        "scrubEnv": ["ANTHROPIC_API_KEY"]
      },
      "sandbox": { "docker-sbx": { "agent": "claude" } },
      "dataHandling": {
        "promptsGoTo": "Anthropic (Claude API)",
        "retention": "30 days; 5 years if model-improvement sharing is on (Free/Pro/Max)",
        "policyUrl": "https://code.claude.com/docs/en/data-usage"
      }
    },
    {
      "id": "aider",
      "kind": "cli",
      "capabilities": {
        "editsFiles": true,
        "research": false,
        "translation": true,
        "writing": true,
        "headless": true
      },
      "trusted": true,
      "tierModels": {
        "frontier": "anthropic/claude-opus-4-8",
        "standard": "anthropic/claude-sonnet-4-5",
        "light": "anthropic/claude-haiku-4-5"
      },
      "invocation": {
        "command": "aider",
        "authFailurePatterns": ["AuthenticationError","Incorrect API key","Invalid API key"],
        "argsTemplate": ["--model", "{model}", "{permissions}", "--no-auto-commits", "--message"],
        "promptChannel": "arg",
        "permissions": {
          "supervised": ["--yes"],
          "unattended": ["--yes-always"]
        }
      },
      "auth": {
        "scrubEnv": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY"]
      },
      "dataHandling": {
        "promptsGoTo": "the configured model provider (aider collects no chat messages)",
        "retention": "set by the configured model provider",
        "policyUrl": "https://aider.chat/docs/legal/privacy.html"
      }
    },
    {
      "id": "codex",
      "kind": "cli",
      "vendor": "openai",
      "capabilities": {
        "editsFiles": true,
        "research": true,
        "translation": false,
        "writing": true,
        "headless": true
      },
      "trusted": true,
      "tierModels": {
        "frontier": "gpt-5-codex",
        "standard": "gpt-5-codex",
        "light": "gpt-5-codex-mini"
      },
      "invocation": {
        "command": "codex",
        "authFailurePatterns": ["Not logged in","access token could not be refreshed","Please (log|sign) in again","Run .?codex login"],
        "argsTemplate": ["exec", "--model", "{model}", "{permissions}"],
        "promptChannel": "arg",
        "permissions": {
          "supervised": ["--sandbox", "workspace-write", "--ask-for-approval", "on-request"],
          "unattended": ["--full-auto"]
        }
      },
      "auth": {
        "keyEnv": "OPENAI_API_KEY",
        "scrubEnv": ["OPENAI_API_KEY"]
      },
      "dataHandling": {
        "promptsGoTo": "OpenAI (ChatGPT plan terms when signed in with ChatGPT)",
        "retention": "unverified",
        "policyUrl": "https://help.openai.com/en/articles/11369540"
      }
    },
    {
      "id": "gemini-cli",
      "kind": "cli",
      "vendor": "google",
      "capabilities": {
        "editsFiles": true,
        "research": true,
        "translation": true,
        "writing": true,
        "headless": true
      },
      "trusted": true,
      "tierModels": {
        "frontier": "gemini-2.5-pro",
        "standard": "gemini-2.5-pro",
        "light": "gemini-2.5-flash"
      },
      "invocation": {
        "command": "gemini",
        "authFailurePatterns": ["Please set an Auth method","Failed to login","API key not valid","Authentication (required|failed)"],
        "argsTemplate": ["-m", "{model}", "{permissions}", "-p"],
        "promptChannel": "arg",
        "permissions": {
          "supervised": ["--approval-mode", "auto_edit"],
          "unattended": ["--approval-mode", "yolo"]
        }
      },
      "auth": {
        "keyEnv": "GEMINI_API_KEY",
        "scrubEnv": ["GEMINI_API_KEY", "GOOGLE_API_KEY"]
      },
      "dataHandling": {
        "promptsGoTo": "Google (Gemini Code Assist or the Gemini API, by sign-in method)",
        "retention": "unverified",
        "policyUrl": "https://geminicli.com/docs/resources/tos-privacy"
      }
    },
    {
      "id": "cursor-agent",
      "kind": "cli",
      "capabilities": {
        "editsFiles": true,
        "research": true,
        "translation": false,
        "writing": true,
        "headless": true
      },
      "trusted": true,
      "tierModels": {
        "frontier": "sonnet",
        "standard": "sonnet",
        "light": "sonnet"
      },
      "invocation": {
        "command": "cursor-agent",
        "authFailurePatterns": ["Not logged in","Authentication required","cursor-agent login"],
        "argsTemplate": ["-p", "--model", "{model}", "{permissions}"],
        "promptChannel": "arg",
        "permissions": {
          "unattended": ["--force"]
        }
      },
      "auth": {
        "scrubEnv": []
      },
      "dataHandling": {
        "promptsGoTo": "Cursor's backend, then its model providers",
        "retention": "not kept by model providers with Privacy Mode on; may be stored and trained on with it off",
        "policyUrl": "https://cursor.com/data-use"
      }
    },
    {
      "id": "kimi",
      "kind": "cli",
      "vendor": "moonshot",
      "capabilities": {
        "editsFiles": true,
        "research": true,
        "translation": true,
        "writing": true,
        "headless": true
      },
      "trusted": false,
      "tierModels": {
        "frontier": "kimi-k3",
        "standard": "kimi-k2.7-code",
        "light": "kimi-k2.7-code-highspeed"
      },
      "invocation": {
        "command": "kimi",
        "authFailurePatterns": ["Not logged in","Please (run )?/?login","Invalid authentication"],
        "argsTemplate": ["--print", "--model", "{model}", "{permissions}"],
        "promptChannel": "stdin",
        "permissions": {
          "unattended": ["--afk"]
        }
      },
      "auth": {
        "keyEnv": "MOONSHOT_API_KEY",
        "scrubEnv": ["MOONSHOT_API_KEY"]
      },
      "dataHandling": {
        "promptsGoTo": "Moonshot AI (Kimi platform)",
        "retention": "unverified",
        "policyUrl": "https://www.kimi.com/user/agreement/userPrivacy?version=v2"
      }
    },
    {
      "id": "anthropic-api",
      "kind": "api",
      "vendor": "anthropic",
      "capabilities": {
        "editsFiles": false,
        "research": true,
        "translation": true,
        "writing": true,
        "headless": true
      },
      "trusted": false,
      "goodFor": ["document", "translation", "dataset"],
      "tierModels": {
        "frontier": "claude-opus-4-8",
        "standard": "claude-sonnet-4-5",
        "light": "claude-haiku-4-5"
      },
      "auth": {
        "keyEnv": "ANTHROPIC_API_KEY",
        "scrubEnv": []
      },
      "dataHandling": {
        "promptsGoTo": "Anthropic API (funded lane, API key)",
        "retention": "deleted within 30 days (standard API); flagged content up to 2 years",
        "policyUrl": "https://privacy.claude.com/en/articles/7996866-how-long-do-you-store-my-organization-s-data"
      }
    },
    {
      "id": "copilot",
      "kind": "cli",
      "capabilities": {
        "editsFiles": true,
        "research": true,
        "translation": false,
        "writing": true,
        "headless": true
      },
      "trusted": false,
      "tierModels": {
        "frontier": "claude-sonnet-4.5",
        "standard": "claude-sonnet-4.5",
        "light": "claude-sonnet-4.5"
      },
      "invocation": {
        "command": "copilot",
        "authFailurePatterns": ["Not logged in","gh auth login","Authentication (required|failed)"],
        "argsTemplate": ["--model", "{model}", "{permissions}", "-p"],
        "promptChannel": "arg",
        "permissions": {
          "unattended": ["--allow-all-tools", "--no-ask-user"]
        }
      },
      "auth": {
        "scrubEnv": []
      },
      "dataHandling": {
        "promptsGoTo": "GitHub Copilot service",
        "retention": "unverified",
        "policyUrl": "https://resources.github.com/learn/pathways/copilot/essentials/how-github-copilot-handles-data"
      }
    }
  ]
}
